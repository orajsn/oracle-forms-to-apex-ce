    "opaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "certificate_sha256",
        "model_authentication",
        "model_credential_reference",
        "authentication_secret_reference",
        "version_number",
        "build_id",
        "processing_approval_reference",
        "roles"
      ],
      "properties": {
        "base_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "x-check": "url"
        },
        "certificate_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "x-check": "sha256"
        },
        "model_authentication": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "oci_instance_principal",
            "oci_resource_principal",
            "opaque_secret_reference",
            null
          ]
        },
        "model_credential_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "x-check": "secret_ref"
        },
        "authentication_secret_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "x-check": "secret_ref"
        },
        "version_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "build_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "processing_approval_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "x-check": "identifier"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapper",
            "reviewer"
          ],
          "properties": {
            "mapper": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workflow_id",
                "model",
                "graph_sha256"
              ],
              "properties": {
                "workflow_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512,
                  "x-check": "identifier"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512,
                  "x-check": "identifier"
                },
                "graph_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512,
                  "x-check": "sha256"
                }
              }
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workflow_id",
                "model",
                "graph_sha256"
              ],
              "properties": {
                "workflow_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512,
                  "x-check": "identifier"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512,
                  "x-check": "identifier"
                },
                "graph_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512,
                  "x-check": "sha256"
                }
              }
            }
          }
        }
      }
