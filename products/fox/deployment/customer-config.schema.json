            "converter_jobs": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "local_path"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "local_path"
            },
            "logs": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "local_path"
            },
            "backups": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "local_path"
            }
          }
        },
        "release_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fox_sha256",
            "converter_sha256",
            "opaf_graph_bundle_sha256"
          ],
          "properties": {
            "fox_sha256": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "sha256"
            },
            "converter_sha256": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "sha256"
            },
            "opaf_graph_bundle_sha256": {
              "type": [
                "string",
