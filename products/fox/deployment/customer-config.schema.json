    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "persistent_locations",
        "release_hashes",
        "backup_reference",
        "backup_evidence_reference",
        "rollback_owner",
        "rollback_reference",
        "maintenance_approval_reference"
      ],
      "properties": {
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "x-check": "label"
        },
        "persistent_locations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fox_data",
            "converter_jobs",
            "evidence",
            "logs",
            "backups"
          ],
          "properties": {
            "fox_data": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512,
              "x-check": "local_path"
